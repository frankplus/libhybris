import("//build/ohos.gni")

# Android version configuration
declare_args() {
  # Android API level for compatibility
  android_version_major = 11
  android_version_minor = 0
  android_version_patch = 0
  
  # Build configuration options
  hybris_enable_debug = false
  hybris_enable_trace = false
  hybris_enable_experimental = false
  hybris_enable_adreno_quirks = false
  hybris_enable_mali_quirks = false
  hybris_enable_arm_tracing = false
  hybris_enable_mesa = false
  hybris_enable_wayland = false
  hybris_enable_glvnd = false
  hybris_enable_property_cache = false
  hybris_enable_ubuntu_linker_overrides = false
  hybris_enable_stub_linker = false
  
  # Architecture selection (arm, arm64, x86, x86-64)
  hybris_arch = "arm64"
  
  # Default EGL platform
  hybris_default_egl_platform = "null"
}

# Default library paths for Android libraries
if (hybris_arch == "arm" || hybris_arch == "x86") {
  hybris_default_ld_library_path = "/vendor/lib:/system/lib:/odm/lib"
} else {
  hybris_default_ld_library_path = "/vendor/lib64:/system/lib64:/odm/lib64"
}

# Common configuration for all libhybris components
config("libhybris_config") {
  include_dirs = []
  
  # Add version-specific bionic includes first (higher priority) based on Android version
  if (android_version_major >= 10) {
    include_dirs += [
      "hybris/common/q/bionic/libc/include",
      "hybris/common/q/bionic/libc",
    ]
  } else if (android_version_major >= 8) {
    include_dirs += [
      "hybris/common/o/bionic/libc/include", 
      "hybris/common/o/bionic/libc",
    ]
  } else if (android_version_major >= 7) {
    include_dirs += [
      "hybris/common/n/bionic/libc/include",
      "hybris/common/n/bionic/libc",
    ]
  }
  
  # Add standard hybris includes after bionic includes
  include_dirs += [
    "hybris/include",
    "hybris",
    "hybris/include/hybris/common",
    "hybris/common",
    "hybris/egl",
    "hybris/platforms/common",
    "//third_party/android-headers",
  ]
  
  defines = [
    "DEFAULT_EGL_PLATFORM=\"$hybris_default_egl_platform\"",
    "DEFAULT_HYBRIS_LD_LIBRARY_PATH=\"$hybris_default_ld_library_path\"",
    "HAVE_CONFIG_H",
    "_GNU_SOURCE",
  ]
  
  cflags = [
    "-Wno-unused-parameter",
    "-Wno-sign-compare",
    "-Wno-missing-field-initializers",
    "-Wno-unused-function",
    "-Wno-implicit-function-declaration",
    "-Wno-deprecated-declarations",
  ]
  
  if (hybris_enable_debug) {
    cflags += [
      "-ggdb",
      "-O0",
    ]
    defines += [ "DEBUG" ]
  }
  
  if (hybris_enable_trace) {
    defines += [ "TRACE" ]
  }
  
  if (hybris_enable_experimental) {
    defines += [ "EXPERIMENTAL" ]
  }
  
  if (hybris_enable_adreno_quirks) {
    defines += [ "WANT_ADRENO_QUIRKS" ]
  }
  
  if (hybris_enable_mali_quirks) {
    defines += [ "WANT_MALI_QUIRKS" ]
  }
  
  if (hybris_enable_arm_tracing) {
    defines += [ "WANT_ARM_TRACING" ]
  }
  
  if (!hybris_enable_property_cache) {
    defines += [ "NO_RUNTIME_PROPERTY_CACHE" ]
  }
  
  # Architecture-specific defines
  if (hybris_arch == "arm") {
    defines += [ "WANT_ARCH_ARM" ]
  } else if (hybris_arch == "arm64") {
    defines += [ "WANT_ARCH_ARM64" ]
  } else if (hybris_arch == "x86") {
    defines += [ "WANT_ARCH_X86" ]
  } else if (hybris_arch == "x86-64") {
    defines += [ "WANT_ARCH_X86_64" ]
  }
  
  # Android version conditionals
  if (android_version_major >= 13) {
    defines += [ "HAS_ANDROID_13_0_0" ]
  }
  if (android_version_major >= 12) {
    defines += [ "HAS_ANDROID_12_0_0" ]
  }
  if (android_version_major >= 11) {
    defines += [ "HAS_ANDROID_11_0_0" ]
  }
  if (android_version_major >= 10) {
    defines += [ "HAS_ANDROID_10_0_0" ]
  }
  if (android_version_major >= 9) {
    defines += [ "HAS_ANDROID_9_0_0" ]
  }
  if (android_version_major >= 8) {
    defines += [ "HAS_ANDROID_8_0_0" ]
  }
  if (android_version_major >= 7) {
    defines += [ "HAS_ANDROID_7_0_0" ]
  }
  if (android_version_major >= 6) {
    defines += [ "HAS_ANDROID_6_0_0" ]
  }
  if (android_version_major >= 5) {
    defines += [ "HAS_ANDROID_5_0_0" ]
  }
  if (android_version_major >= 4) {
    if (android_version_minor >= 2) {
      defines += [ "HAS_ANDROID_4_2_0" ]
    }
    if (android_version_minor >= 1) {
      defines += [ "HAS_ANDROID_4_1_0" ]
    }
    if (android_version_patch >= 3) {
      defines += [ "HAS_ANDROID_4_0_3" ]
    }
    defines += [ "HAS_ANDROID_4_0_0" ]
  }
  if (android_version_major >= 2 && android_version_minor >= 3) {
    defines += [ "HAS_ANDROID_2_3_0" ]
  }
}

# Build libhybris-common library
ohos_shared_library("libhybris-common") {
  sources = [
    "hybris/common/hooks.c",
    "hybris/common/hooks_shm.c",
    "hybris/common/strlcpy.c",
    "hybris/common/strlcat.c",
    "hybris/common/logging.c",
    "hybris/common/native_handle.c",
    "hybris/common/sysconf.c",
    "hybris/common/dso_handle_counters.cpp",
    "hybris/common/legacy_properties/properties.c",
    "hybris/common/legacy_properties/cache.c",
  ]

  if (hybris_enable_property_cache) {
    sources += [ "hybris/common/legacy_properties/runtime_cache.c" ]
  }
  
  if (hybris_enable_arm_tracing) {
    sources += [
      "hybris/common/wrappers.c",
      "hybris/common/wrapper_code_generic_arm.c",
    ]
  }
  
  # Add version-specific linker sources
  if (hybris_arch != "arm64" && hybris_arch != "x86-64") {
    sources += [
      "hybris/common/jb/dlfcn.c",
      "hybris/common/jb/linker.c",
      "hybris/common/jb/linker_environ.c",
      "hybris/common/jb/linker_format.c",
      "hybris/common/jb/rt.c",
    ]
  }
  
  if (android_version_major >= 6) {
    sources += [
      "hybris/common/mm/hybris_compat.cpp",
      "hybris/common/mm/dlfcn.cpp",
      "hybris/common/mm/linker.cpp",
      "hybris/common/mm/linker_allocator.cpp",
      "hybris/common/mm/linker_block_allocator.cpp",
      "hybris/common/mm/linker_memory.cpp",
      "hybris/common/mm/linker_phdr.cpp",
      "hybris/common/mm/linker_sdk_versions.cpp",
      "hybris/common/mm/rt.cpp",
    ]
  }
  
  if (android_version_major >= 7) {
    sources += [
      "hybris/common/n/hybris_compat.cpp",
      "hybris/common/n/dlfcn.cpp",
      "hybris/common/n/linker.cpp",
      "hybris/common/n/linker_allocator.cpp", 
      "hybris/common/n/linker_block_allocator.cpp",
      "hybris/common/n/linker_dlwarning.cpp",
      "hybris/common/n/linker_gdb_support.cpp",
      "hybris/common/n/linker_mapped_file_fragment.cpp",
      "hybris/common/n/linker_memory.cpp",
      "hybris/common/n/linker_phdr.cpp",
      "hybris/common/n/linker_sdk_versions.cpp",
      "hybris/common/n/linker_utils.cpp",
      "hybris/common/n/rt.cpp",
    ]
  }
  
  if (android_version_major >= 8) {
    sources += [
      "hybris/common/o/hybris_compat.cpp",
      "hybris/common/o/dlfcn.cpp",
      "hybris/common/o/linker.cpp",
      "hybris/common/o/linker_allocator.cpp",
      "hybris/common/o/linker_block_allocator.cpp", 
      "hybris/common/o/linker_cfi.cpp",
      "hybris/common/o/linker_config.cpp",
      "hybris/common/o/linker_dlwarning.cpp",
      "hybris/common/o/linker_gdb_support.cpp",
      "hybris/common/o/linker_globals.cpp",
      "hybris/common/o/linker_logger.cpp",
      "hybris/common/o/linker_main.cpp",
      "hybris/common/o/linker_mapped_file_fragment.cpp",
      "hybris/common/o/linker_memory.cpp",
      "hybris/common/o/linker_namespaces.cpp",
      "hybris/common/o/linker_phdr.cpp",
      "hybris/common/o/linker_sdk_versions.cpp",
      "hybris/common/o/linker_soinfo.cpp",
      "hybris/common/o/linker_utils.cpp",
      "hybris/common/o/rt.cpp",
    ]
  }
  
  if (android_version_major >= 10) {
    sources += [
      "hybris/common/q/hybris_compat.cpp",
      "hybris/common/q/bionic/libc/bionic/bionic_call_ifunc_resolver.cpp",
      "hybris/common/q/dlfcn.cpp",
      "hybris/common/q/linker.cpp",
      "hybris/common/q/linker_allocator.cpp",
      "hybris/common/q/linker_block_allocator.cpp",
      "hybris/common/q/linker_cfi.cpp",
      "hybris/common/q/linker_config.cpp",
      "hybris/common/q/linker_dlwarning.cpp",
      "hybris/common/q/linker_gdb_support.cpp",
      "hybris/common/q/linker_globals.cpp",
      "hybris/common/q/linker_logger.cpp",
      "hybris/common/q/linker_main.cpp",
      "hybris/common/q/linker_mapped_file_fragment.cpp",
      "hybris/common/q/linker_memory.cpp", 
      "hybris/common/q/linker_namespaces.cpp",
      "hybris/common/q/linker_phdr.cpp",
      "hybris/common/q/linker_sdk_versions.cpp",
      "hybris/common/q/linker_soinfo.cpp",
      "hybris/common/q/linker_tls.cpp",
      "hybris/common/q/linker_utils.cpp",
      "hybris/common/q/rt.cpp",
      "hybris/common/q/bionic/libc/bionic/bionic_elf_tls.cpp",
      "hybris/common/q/bionic/libc/bionic/bionic_allocator.cpp",
    ]
    
    # ARM64-specific assembly file
    if (hybris_arch == "arm64") {
      sources += [ "hybris/common/q/tlsdesc_resolver.S" ]
    }
  }
  
  configs = [ ":libhybris_config" ]
  
  deps = []
  
  external_deps = [
    "c_utils:utils",
  ]
  
  install_images = [
    "system",
    "updater",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

