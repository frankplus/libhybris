import("//build/ohos.gni")

# Build libhwc2 (Hardware Composer 2)
ohos_shared_library("libhwc2") {
  sources = [
    "hwc2.c",
  ]

  configs = [ "../../:libhybris_config" ]

  defines = [
    "HAS_HWCOMPOSER2_HEADERS=1",
    # RTLD_LAZY is normally from <dlfcn.h>, but the libhybris_config adds
    # hybris/include/hybris/common to the include path, which causes
    # #include <dlfcn.h> to resolve to the hybris custom dlfcn.h (no RTLD_LAZY).
    "RTLD_LAZY=1",
  ]

  include_dirs = [
    "../include",
    "//third_party/android-headers",
  ]

  deps = [
    "../common:libhybris-common",
  ]

  install_images = [
    "system",
    "updater",
  ]

  part_name = "libhybris"
  subsystem_name = "thirdparty"
}
