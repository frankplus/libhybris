import("//build/ohos.gni")
import("../../../libhybris_args.gni")

# Configuration for Android 6.0 (MM) specific sources
config("libhybris_mm_config") {
  include_dirs = [
    "../../common/mm/bionic/libc/include",
    "../../common/mm/bionic/libc",
  ]
}

# Configuration for Android 7.0 (N) specific sources  
config("libhybris_n_config") {
  include_dirs = [
    "../../common/n/bionic/libc/include",
    "../../common/n/bionic/libc",
  ]
}

# Configuration for Android 8.0 (O) specific sources
config("libhybris_o_config") {
  include_dirs = [
    "../../common/o/bionic/libc/include", 
    "../../common/o/bionic/libc",
  ]
}

# Configuration for Android 10.0 (Q) specific sources
config("libhybris_q_config") {
  include_dirs = [
    "../../common/q/bionic/libc/include",
    "../../common/q/bionic/libc",
    "../../common/q"
  ]
}

# Build EGL platform common library (equivalent to libhybris-eglplatformcommon.la)
ohos_static_library("libhybris-eglplatformcommon") {
  sources = [
    "common/eglplatformcommon.cpp",
  ]
  
  configs = [ "../../../:libhybris_config" ]
  
  include_dirs = [
    "../../include",
    "../../common",
    "..",
    "common",
    "../../platforms/common",
  ]
  
  cflags = []
  cflags_cc = []
  
  if (hybris_enable_trace) {
    cflags += [ "-DDEBUG" ]
    cflags_cc += [ "-DDEBUG" ]
  }
  
  if (hybris_enable_debug) {
    cflags += [ "-ggdb", "-O0" ]
    cflags_cc += [ "-ggdb", "-O0" ]
  }
  
  if (hybris_enable_mesa) {
    cflags += [ "-DLIBHYBRIS_WANTS_MESA_X11_HEADERS" ]
    cflags_cc += [ "-DLIBHYBRIS_WANTS_MESA_X11_HEADERS" ]
  }
  
  deps = [
    "../../common:libhybris-common",
    "../../gralloc:libgralloc",
    "../../platforms:libhybris-platformcommon",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Build EGL platform null (debug platform that doesn't require complex integration)
ohos_shared_library("eglplatform_null") {
  sources = [
    "null/eglplatform_null.c",
  ]
    
  # Add Android version-specific bionic headers for dlfcn.h
  configs = []
  if (android_version_major >= 10) {
    configs += [ ":libhybris_q_config" ]
  } else if (android_version_major >= 8) {
    configs += [ ":libhybris_o_config" ]
  } else if (android_version_major >= 7) {
    configs += [ ":libhybris_n_config" ]
  } else if (android_version_major >= 6) {
    configs += [ ":libhybris_mm_config" ]
  }
  
  configs += [ "../../../:libhybris_config" ]
  
  include_dirs = [
    "../../include",
    "../../common",
    "..",
    "common",
  ]
  
  cflags = []
  
  if (hybris_enable_trace) {
    cflags += [ "-DDEBUG" ]
  }
  
  if (hybris_enable_debug) {
    cflags += [ "-ggdb", "-O0" ]
  }
  
  deps = [
    ":libhybris-eglplatformcommon",
    "../../gralloc:libgralloc",
  ]
  
  # Module flags to match autotools behavior
  ldflags = [
    "-Wl,--no-undefined",
    "-Wl,--export-dynamic",
  ]
  
  install_images = [
    "system",
    "updater",
  ]
  
  # Install to the platform-specific directory
  relative_install_dir = "libhybris"
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Group target that builds the platforms (equivalent to SUBDIRS in Makefile.am)
group("platforms") {
  deps = [
    ":libhybris-eglplatformcommon",
    ":eglplatform_null",
    "ohos:eglplatform_ohos",
  ]
  
  deps += [ "hwcomposer:eglplatform_hwcomposer" ]

  # if (hybris_enable_wayland) {
  #   deps += [ ":eglplatform_wayland" ]
  # }
}
