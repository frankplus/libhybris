import("//build/ohos.gni")
import("../../../libhybris_args.gni")

# Build EGL platform common library (equivalent to libhybris-eglplatformcommon.la)
ohos_static_library("libhybris-eglplatformcommon") {
  sources = [
    "common/eglplatformcommon.cpp",
  ]
  
  configs = [ "../../../:libhybris_config" ]
  
  include_dirs = [
    "../../include",
    "../../common",
    "..",
    "common",
    "../../platforms/common",
  ]
  
  cflags = []
  cflags_cc = []
  
  if (hybris_enable_trace) {
    cflags += [ "-DDEBUG" ]
    cflags_cc += [ "-DDEBUG" ]
  }
  
  if (hybris_enable_debug) {
    cflags += [ "-ggdb", "-O0" ]
    cflags_cc += [ "-ggdb", "-O0" ]
  }
  
  if (hybris_enable_mesa) {
    cflags += [ "-DLIBHYBRIS_WANTS_MESA_X11_HEADERS" ]
    cflags_cc += [ "-DLIBHYBRIS_WANTS_MESA_X11_HEADERS" ]
  }
  
  deps = [
    "../../common:libhybris-common",
    "../../gralloc:libgralloc",
    "../../platforms:libhybris-platformcommon",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Build EGL platform null (debug platform that doesn't require complex integration)
ohos_shared_library("eglplatform_null") {
  sources = [
    "null/eglplatform_null.c",
  ]
  
  configs = [ "../../../:libhybris_config" ]
  
  include_dirs = [
    "../../include",
    "../../common",
    "..",
    "common",
  ]
  
  cflags = []
  
  if (hybris_enable_trace) {
    cflags += [ "-DDEBUG" ]
  }
  
  if (hybris_enable_debug) {
    cflags += [ "-ggdb", "-O0" ]
  }
  
  deps = [
    ":libhybris-eglplatformcommon",
    "../../gralloc:libgralloc",
  ]
  
  # Module flags to match autotools behavior
  ldflags = [
    "-Wl,--no-undefined",
    "-Wl,--export-dynamic",
  ]
  
  install_images = [
    "system",
    "updater",
  ]
  
  # Install to the platform-specific directory
  relative_install_dir = "libhybris"
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Group target that builds the platforms (equivalent to SUBDIRS in Makefile.am)
group("platforms") {
  deps = [
    ":libhybris-eglplatformcommon",
    ":eglplatform_null",
    "ohos:eglplatform_ohos",
  ]
  
  # Add other platforms conditionally when they are implemented
  # if (android_version_major >= 4 && android_version_minor >= 2) {
  #   deps += [ ":eglplatform_hwcomposer" ]
  # }
  # 
  # if (hybris_enable_wayland) {
  #   deps += [ ":eglplatform_wayland" ]
  # }
}
