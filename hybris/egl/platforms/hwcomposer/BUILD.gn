import("//build/ohos.gni")
import("../../../../libhybris_args.gni")

# Build libhybris-hwcomposerwindow (HWComposer window abstraction)
ohos_shared_library("libhybris-hwcomposerwindow") {
  sources = [
    "hwcomposer_window.cpp",
  ]

  configs = [ "../../../../:libhybris_config" ]

  include_dirs = [
    "../../../include",
    "../../../common",
    "../../..",
    "../common",
    "../../../platforms/common",
    "//third_party/android-headers",
  ]

  cflags_cc = []

  if (hybris_enable_trace) {
    cflags_cc += [ "-DDEBUG" ]
  }
  if (hybris_enable_debug) {
    cflags_cc += [ "-ggdb", "-O0" ]
  }

  deps = [
    "../:libhybris-eglplatformcommon",
    "../../../gralloc:libgralloc",
    "../../../platforms:libhybris-platformcommon",
  ]

  if (android_version_major >= 4 && android_version_minor >= 2) {
    deps += [ "../../../libsync:libsync" ]
  }

  ldflags = [
    "-Wl,--no-undefined",
    "-Wl,--export-dynamic",
  ]

  install_images = [
    "system",
    "updater",
  ]

  relative_install_dir = "libhybris"

  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Build eglplatform_hwcomposer (EGL platform plugin for HWC2)
ohos_shared_library("eglplatform_hwcomposer") {
  sources = [
    "eglplatform_hwcomposer.cpp",
  ]

  configs = [ "../../../../:libhybris_config" ]

  include_dirs = [
    "../../../include",
    "../../../common",
    "../../..",
    "../common",
    "../../../platforms/common",
    "//third_party/android-headers",
  ]

  cflags_cc = []

  if (hybris_enable_trace) {
    cflags_cc += [ "-DDEBUG" ]
  }
  if (hybris_enable_debug) {
    cflags_cc += [ "-ggdb", "-O0" ]
  }

  deps = [
    ":libhybris-hwcomposerwindow",
    "../:libhybris-eglplatformcommon",
    "../../../gralloc:libgralloc",
  ]

  ldflags = [
    "-Wl,--no-undefined",
    "-Wl,--export-dynamic",
  ]

  install_images = [
    "system",
    "updater",
  ]

  relative_install_dir = "libhybris"

  part_name = "libhybris"
  subsystem_name = "thirdparty"
}
