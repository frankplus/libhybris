import("//build/ohos.gni")
import("../../../../libhybris_args.gni")

# Build EGL platform for OpenHarmony (equivalent to libeglplatform_ohos.so)
ohos_shared_library("eglplatform_ohos") {
  sources = [
    "eglplatform_ohos.cpp",
    "ohos_window.cpp",
  ]
  
  configs = [ "../../../../:libhybris_config" ]
  
  include_dirs = [
    "../../../include",
    "../../../common",
    "../..",
    "../common",
    # "//drivers/peripheral/display/interfaces/include",
    # "//drivers/peripheral/base",
    "//foundation/graphic/graphic_surface/interfaces/inner_api/surface",
    "//foundation/graphic/graphic_surface/interfaces/inner_api/utils",
  ]
  
  cflags = [
    "-DPLATFORM_OHOS",
    "-DNATIVE_WINDOW_TYPE_OHOS=4",
  ]
  cflags_cc = [
    "-DPLATFORM_OHOS", 
    "-DNATIVE_WINDOW_TYPE_OHOS=4",
  ]
  
  if (hybris_enable_trace) {
    cflags += [ "-DDEBUG" ]
    cflags_cc += [ "-DDEBUG" ]
  }
  
  if (hybris_enable_debug) {
    cflags += [ "-ggdb", "-O0" ]
    cflags_cc += [ "-ggdb", "-O0" ]
  }
  
  deps = [
    "../:libhybris-eglplatformcommon",
    "../../../gralloc:libgralloc",
  ]
  
  external_deps = [
  ]
  
  # Module flags to match autotools behavior
  ldflags = [
    "-Wl,--no-undefined",
    "-Wl,--export-dynamic",
  ]
  
  install_images = [
    "system",
    "updater",
  ]
  
  # Install to the platform-specific directory
  relative_install_dir = "libhybris"
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}
