  # test_camera - Camera test (Wayland only)
  ohos_executable("test_camera") {
    sources = [
      "test_camera.cpp",
      "test_common.cpp",
    ]
    
    configs = [
      "../../:libhybris_config",
      ":test_config",
    ]
    
    include_dirs = [
      "../common",
      "../platforms/common",
      "../egl/platforms/common",
      "../egl/platforms/hwcomposer",
      "../libsync",
    ]
    
    cxxflags = [ "-std=gnu++11" ]
    
    # HWComposer2 support detection
    cxxflags += [ "-DHAS_HWCOMPOSER2_HEADERS=1" ]
    
    deps = [
      "../common:libhybris-common",
      "../camera:libcamera",
      "../input:libis",
    ]
    
    if (hybris_enable_glvnd) {
      external_deps = [ libegl_dependency, libglesv2_dependency ]
    } else {
      deps += [ libegl_dependency, libglesv2_dependency ]
    }
    
    # Add Wayland dependencies if available
    # external_deps += [ "wayland-egl", "wayland-client" ]
    
    install_images = [
      "system",
      "updater",
    ]
    
    part_name = "libhybris"
    subsystem_name = "thirdparty"
  }
  
  # test_vulkan - Vulkan test (Wayland + Vulkan headers required)
  ohos_executable("test_vulkan") {
    sources = [
      "test_vulkan.cpp",
    ]
    
    configs = [
      "../../:libhybris_config",
      ":test_config",
    ]
    
    deps = [
      "../common:libhybris-common",
      "../vulkan:libvulkan",
    ]
    
    # Add Wayland dependencies if available  
    # external_deps = [ "wayland-client" ]
    
    install_images = [
      "system",
      "updater",
    ]
    
    part_name = "libhybris"
    subsystem_name = "thirdparty"
  }
}

# Group target for all test programs
group("tests") {
  deps = [
    ":test_audio",
    ":test_egl",
    ":test_egl_configs",
    ":test_glesv2",
    ":test_glesv3",
    ":test_sf",
    ":test_sensors",
