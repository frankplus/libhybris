import("//build/ohos.gni")
import("../../libhybris_args.gni")

# Test configuration
config("test_config") {
  include_dirs = [
    "../../hybris/include",
    "../../hybris",
    "//third_party/android-headers",
  ]
}

# Variables to handle conditional EGL/GLES linking (matching Makefile.am behavior)
if (hybris_enable_glvnd) {
  # When GLVND is enabled, link with system EGL/GLES
  libegl_dependency = "EGL"
} else {
  # Link with libhybris EGL/GLES
  libegl_dependency = "../egl:libEGL"
}

# Configuration for Android 6.0 (MM) specific sources
config("libhybris_mm_config") {
  include_dirs = [
    "../common/mm/bionic/libc/include",
    "../common/mm/bionic/libc",
  ]
}

# Configuration for Android 7.0 (N) specific sources  
config("libhybris_n_config") {
  include_dirs = [
    "../common/n/bionic/libc/include",
    "../common/n/bionic/libc",
  ]
}

# Configuration for Android 8.0 (O) specific sources
config("libhybris_o_config") {
  include_dirs = [
    "../common/o/bionic/libc/include", 
    "../common/o/bionic/libc",
  ]
}

# Configuration for Android 10.0 (Q) specific sources
config("libhybris_q_config") {
  include_dirs = [
    "../common/q/bionic/libc/include",
    "../common/q/bionic/libc",
    "../common/q"
  ]
}

# test_egl - Basic EGL test
ohos_executable("test_egl") {
  sources = [
    "test_egl.cpp",
  ]
  
  configs = [
    "../../:libhybris_config",
    ":test_config",
  ]
  
  include_dirs = [
    "../egl/platforms/common",
    "../egl/platforms/hwcomposer",
    "../libsync",
    "../common",
    "../platforms/common",
  ]
  
  deps = [
    "../common:libhybris-common",
  ]
  
  if (hybris_enable_glvnd) {
    external_deps = [ libegl_dependency ]
  } else {
    deps += [ libegl_dependency ]
  }
  
  install_images = [
    "system",
    "updater",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# test_egl_configs - EGL configuration test
ohos_executable("test_egl_configs") {
  sources = [
    "test_egl_configs.c",
  ]
  
  configs = [
    "../../:libhybris_config",
    ":test_config",
  ]
  
  deps = [
    "../common:libhybris-common",
  ]
  
  # Link with EGL library
  if (hybris_enable_glvnd) {
    external_deps = [ libegl_dependency ]
  } else {
    deps += [ libegl_dependency ]
  }
  
  install_images = [
    "system",
    "updater",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# test_dlopen - Dynamic library loading test
ohos_executable("test_dlopen") {
  sources = [
    "test_dlopen.c",
  ]

  # Add Android version-specific bionic headers for dlfcn.h
  configs = []
  if (android_version_major >= 10) {
    configs += [ ":libhybris_q_config" ]
  } else if (android_version_major >= 8) {
    configs += [ ":libhybris_o_config" ]
  } else if (android_version_major >= 7) {
    configs += [ ":libhybris_n_config" ]
  } else if (android_version_major >= 6) {
    configs += [ ":libhybris_mm_config" ]
  }
  
  configs += [
    "../../:libhybris_config",
    ":test_config",
  ]
  
  deps = [
    "../common:libhybris-common",
    "../hardware:libhardware",
  ]
  
  install_images = [
    "system",
    "updater",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# test_hwcomposer - Full HWComposer2 display and GLES2 rendering test
ohos_executable("test_hwcomposer") {
  sources = [
    "test_hwcomposer.cpp",
    "test_common.cpp",
  ]

  configs = [
    "../../:libhybris_config",
    ":test_config",
  ]

  defines = [
    "USE_HWCOMPOSER=1",
    "HAS_HWCOMPOSER2_HEADERS=1",
  ]

  include_dirs = [
    "../egl/platforms/hwcomposer",
    "../egl/platforms/common",
    "../libsync",
    "../common",
    "../platforms/common",
    "../hwc2",
    "//third_party/android-headers",
  ]

  deps = [
    "../common:libhybris-common",
    "../hardware:libhardware",
    "../hwc2:libhwc2",
    "../egl/platforms/hwcomposer:libhybris-hwcomposerwindow",
    "../libsync:libsync",
    "../glesv2:libGLESv2",
  ]

  if (hybris_enable_glvnd) {
    external_deps = [ libegl_dependency ]
  } else {
    deps += [ libegl_dependency ]
  }

  install_images = [
    "system",
    "updater",
  ]

  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Group target for all test programs
group("tests") {
  deps = [
    ":test_egl",
    ":test_egl_configs",
    ":test_dlopen",
    ":test_hwcomposer",
  ]
}
