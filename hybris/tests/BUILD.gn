# test_glesv2 - OpenGL ES 2.0 test
ohos_executable("test_glesv2") {
  sources = [
    "test_glesv2.cpp",
    "test_common.cpp",
  ]
  
  configs = [
    "../../:libhybris_config",
    ":test_config",
  ]
  
  include_dirs = [
    "../common",
    "../platforms/common",
    "../egl/platforms/common",
    "../egl/platforms/hwcomposer",
    "../libsync",
  ]
  
  cxxflags = [
    "-std=gnu++11",
    "-DUSE_HWCOMPOSER=1",
  ]
  
  if (hybris_enable_mesa) {
    cxxflags += [ "-DLIBHYBRIS_WANTS_MESA_X11_HEADERS" ]
  }
  
  # HWComposer2 support detection
  cxxflags += [ "-DHAS_HWCOMPOSER2_HEADERS=1" ]
  
  libs = [ "m" ]
  
  deps = [
    "../common:libhybris-common",
    "../egl/platforms:libhybris-eglplatformcommon",
    "../platforms:libhybris-platformcommon",
    "../hardware:libhardware",
  ]
  
  # Add libsync for Android 4.2+ and 5.0+
  if ((android_version_major >= 4 && android_version_minor >= 2) || 
      (android_version_major >= 5)) {
    deps += [ "../libsync:libsync" ]
  }
  
  # Add HWComposer2 support if available
  deps += [ "../hwc2:libhwc2" ]
  
  # Note: hwcomposer window component not yet implemented in BUILD.gn
  # Original Makefile.am includes: $(top_builddir)/egl/platforms/hwcomposer/libhybris-hwcomposerwindow.la
  
  if (hybris_enable_glvnd) {
    external_deps = [ libegl_dependency, libglesv2_dependency ]
  } else {
    deps += [ libegl_dependency, libglesv2_dependency ]
  }
  
  install_images = [
    "system",
    "updater",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

