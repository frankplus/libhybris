    ":test_recorder",
    ":test_gps",
    ":test_opencl",
    ":test_wifi",
    ":test_hwcomposer",
    ":test_nfc",
    ":test_dlopen",
  ]
  
  # Add Wayland-conditional tests
  if (hybris_enable_wayland) {
    deps += [
      ":test_camera",
      ":test_vulkan",
    ]
