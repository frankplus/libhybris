import("//build/ohos.gni")
import("../../libhybris_args.gni")

# Test configuration
config("test_config") {
  include_dirs = [
    "../../hybris/include",
    "../../hybris",
    "//third_party/android-headers",
  ]
}

# test_egl_configs test executable
ohos_executable("test_egl_configs") {
  sources = [
    "test_egl_configs.c",
  ]
  
  configs = [
    "../../:libhybris_config",
    ":test_config",
  ]
  
  deps = [
    "../common:libhybris-common",
  ]
  
  # Link with EGL library
  if (hybris_enable_glvnd) {
    # When GLVND is enabled, link with system EGL
    external_deps = [ "EGL" ]
  } else {
    # Link with libhybris EGL
    deps += [ "../egl:libEGL" ]
  }
  
  install_images = [
    "system",
    "updater", 
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Group target for all test programs (for future expansion)
group("tests") {
  deps = [
    ":test_egl_configs",
  ]
}
