import("//build/ohos.gni")
import("../../libhybris_args.gni")

# Configuration for Android 6.0 (MM) specific sources
config("libhybris_mm_config") {
  include_dirs = [
    "mm/bionic/libc/include",
    "mm/bionic/libc",
  ]
}

# Configuration for Android 7.0 (N) specific sources  
config("libhybris_n_config") {
  include_dirs = [
    "n/bionic/libc/include",
    "n/bionic/libc",
  ]
}

# Configuration for Android 8.0 (O) specific sources
config("libhybris_o_config") {
  include_dirs = [
    "o/bionic/libc/include", 
    "o/bionic/libc",
  ]
}

# Configuration for Android 10.0 (Q) specific sources
config("libhybris_q_config") {
  include_dirs = [
    "q/bionic/libc/include",
    "q/bionic/libc",
    "q"
  ]
}

# Build libhybris-common library
# This contains ONLY the core hybris functionality, NOT the linker modules
# (those are built separately and loaded at runtime)
ohos_shared_library("libhybris-common") {
  sources = [
    "hooks.c",
    "hooks_shm.c", 
    "strlcpy.c",
    "strlcat.c",
    "logging.c",
    "native_handle.c",
    "sysconf.c",
    "dso_handle_counters.cpp",
    "legacy_properties/properties.c",
    "legacy_properties/cache.c",
  ]

  if (hybris_enable_property_cache) {
    sources += [ "legacy_properties/runtime_cache.c" ]
  }
  
  if (hybris_enable_arm_tracing) {
    sources += [
      "wrappers.c",
      "wrapper_code_generic_arm.c",
    ]
  }
  
  # Use base configuration plus Android version-specific headers for hooks.c
  configs = []
  
  # Add Android version-specific bionic headers for dlfcn.h and Dl_info
  if (android_version_major >= 10) {
    configs += [ ":libhybris_q_config" ]
  } else if (android_version_major >= 8) {
    configs += [ ":libhybris_o_config" ]
  } else if (android_version_major >= 7) {
    configs += [ ":libhybris_n_config" ]
  } else if (android_version_major >= 6) {
    configs += [ ":libhybris_mm_config" ]
  }

  configs += [ "../../:libhybris_config" ]
  
  deps = []
  
  external_deps = [
    "c_utils:utils",
  ]
  
  install_images = [
    "system",
    "updater",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

# Android Linker Modules
# These are essential components that provide Android version-specific linker implementations.
# They are loaded at runtime by hooks.c based on detected Android SDK version.

# JellyBean linker module (Android API 16-20)
ohos_shared_library("jb") {
  sources = [
    "jb/dlfcn.c",
    "jb/linker.c", 
    "jb/linker_environ.c",
    "jb/linker_format.c",
    "jb/rt.c",
    "strlcpy.c",
  ]
  
  include_dirs = [
    "../include",
    ".",
  ]
  
  cflags = [
    "-DDEFAULT_HYBRIS_LD_LIBRARY_PATH=\"${hybris_default_ld_library_path}\"",
    "-DLINKER_DEBUG=0",
  ]
  
  if (hybris_arch == "arm") {
    cflags += [
      "-DHAVE_ARM_TLS_REGISTER",
      "-DANDROID_ARM_LINKER",
    ]
  } else if (hybris_arch == "x86") {
    cflags += [ "-DANDROID_X86_LINKER" ]
  }
  
  if (hybris_enable_debug) {
    cflags += [ "-DLINKER_DEBUG=1" ]
  }
  
  if (hybris_enable_arm_tracing && hybris_arch == "arm") {
    cflags += [ "-DWANT_ARM_TRACING" ]
  }
  
  # Install to linker directory
  install_enable = true
  relative_install_dir = "libhybris/linker"
  output_name = "jb"
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}

