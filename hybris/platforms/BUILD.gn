import("//build/ohos.gni")
import("../../libhybris_args.gni")

# Build platforms common library
ohos_static_library("libhybris-platformcommon") {
  sources = [
    "common/nativewindowbase.cpp",
    "common/platformcommon.cpp",
    "common/windowbuffer.cpp",
  ]

  if (hybris_enable_wayland) {
    sources += [
      "common/server_wlegl.cpp",
      "common/server_wlegl_buffer.cpp",
      "common/server_wlegl_handle.cpp",
      "common/wayland-android-protocol.c",
    ]
  }

  configs = [ "../../:libhybris_config" ]
  
  deps = [
    "../common:libhybris-common",
  ]
  
  part_name = "libhybris"
  subsystem_name = "thirdparty"
}